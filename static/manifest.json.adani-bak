{
  "id": "/?source=pwa",
  "name": "AlphaHunt — Stock Intelligence",
  "short_name": "AlphaHunt",
  "description": "Hunt for alpha — Alpha Score scanner with IBD-style RS Rating, Hot List picks, post-earnings highlights, and position sizing.",
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "start_url": "/app?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#18C729",
  "background_color": "#ffffff",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    {
      "src": "/static/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
