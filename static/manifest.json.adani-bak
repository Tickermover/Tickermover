      "url": "/app?tab=hot&source=pwa-shortcut",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Risk Radar",
      "short_name": "Risk",
      "description": "Stocks with risk flags",
      "url": "/app?tab=risk&source=pwa-shortcut",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Score Tracker",
      "short_name": "Tracker",
      "description": "Top 10 stocks our score is tracking",
      "url": "/app?tab=portfolio&source=pwa-shortcut",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "All Stocks",
      "short_name": "Universe",
