# ── Copy this to .env for local dev, or paste into Railway Variables tab ──────
# NEVER commit .env to git — add .env to .gitignore

# ── Alpaca Markets (FREE — use this first!) ─────────────────────────────────
# Sign up: https://alpaca.markets → Paper Trading → API Keys (no credit card)
ALPACA_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ── Polygon.io (optional paid upgrade, $29/mo — skip until you have revenue) ─
POLYGON_API_KEY=
POLYGON_PLAN=starter

# Financial Modeling Prep  →  https://financialmodelingprep.com
FMP_API_KEY=your_fmp_key_here

# Finnhub (supplemental news)  →  https://finnhub.io
FINNHUB_KEY=your_finnhub_key_here

# Supabase  →  https://supabase.com  (free tier fine)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Razorpay  →  https://razorpay.com  (Indian payments)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# After first deploy, create the Pro plan once and paste its ID here:
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxx

# ── Email ──────────────────────────────────────────────────────────────
# Supabase sends "Confirm signup", "Reset password" and "Magic link" via
# its built-in flow (custom SMTP = Resend, configured in the Supabase
# dashboard — no env vars needed here for those).
#
# Google OAuth signups SKIP Supabase's confirm email, so we send our own
# welcome email via Resend's REST API. That needs an API key here:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=TickerMover <noreply@tickermover.com>
# SEC EDGAR requires a REAL contact email in the User-Agent. Defaults to
# support@tickermover.com in code; override here if you want a different one.
SEC_EDGAR_UA=TickerMover research support@tickermover.com

# ── AI providers ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY powers the weekly editorial, overviews, Ask AI and the
# earnings-call summaries behind /api/event-intel (the "what management said"
# box on the Fact Check tab). When its balance is exhausted those features go
# silently empty.
ANTHROPIC_API_KEY=
# GROQ_API_KEY is the FREE-TIER fallback for the earnings-call summary
# (event_intel._summarize_with_groq). Set this and the Fact Check management
# box keeps working even when the Anthropic balance is dry. Get a key at
# console.groq.com — the free tier is enough for this use.
GROQ_API_KEY=

# Site origin — used for transactional email links + forgot-password redirect
SITE_ORIGIN=https://alphahunt.in

# Account settings (optional — override defaults)
ACCOUNT_SIZE_USD=50000
HOT_LIST_N=20
UNIVERSE_MODE=hg
